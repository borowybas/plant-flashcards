# Copy this file to `keystore.properties` (same folder) and fill in your own values.
# `keystore.properties` and the keystore itself are git-ignored – never commit them.
#
# Create a keystore once with (keytool comes with the JDK):
#   keytool -genkeypair -keystore my-release.jks -storetype PKCS12 -alias plantflashcards \
#           -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=Plant Flashcards"
#
# Keep the keystore and the passwords backed up: without them you cannot publish updates
# that install over an existing installation of the app.

storeFile=C:/path/to/my-release.jks
storePassword=change-me
keyAlias=plantflashcards
keyPassword=change-me
